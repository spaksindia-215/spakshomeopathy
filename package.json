{
  "name": "spakshomeopathy-next",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js 1:1 migration of the Spaks Homeopathy Laravel 5.8 application. Governed by MIGRATION-CONTRACT.md.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:herbs": "playwright test --config=playwright.herbs.config.ts",
    "test:e2e:herbs:ui": "playwright test --config=playwright.herbs.config.ts --ui",
    "baseline:capture": "tsx scripts/capture-baseline.ts",
    "baseline:capture-raw": "tsx scripts/capture-raw-html.ts",
    "baseline:db": "tsx scripts/capture-db-baseline.ts",
    "verify:m1": "tsx scripts/verify-m1.ts",
    "verify:m1:screenshots": "playwright test tests/e2e/m1-screenshots.spec.ts --project=chromium-desktop --project=chromium-tablet --project=chromium-mobile",
    "assets:copy": "tsx scripts/copy-assets.ts",
    "assets:verify": "tsx scripts/verify-assets.ts",
    "assets:harvest": "tsx scripts/harvest-referenced-assets.ts",
    "assets:audit": "tsx scripts/audit-live-assets.ts",
    "assets:apply-live": "tsx scripts/apply-live-assets.ts",
    "assets:manifest": "tsx scripts/rebuild-asset-manifest.ts",
    "migrate:dry-run": "tsx scripts/migrate.ts",
    "migrate:mongodb": "tsx scripts/migrate-to-mongodb.ts",
    "migrate:mongodb:dry-run": "tsx scripts/migrate-to-mongodb.ts --dry-run",
    "mongodb:check": "tsx scripts/check-mongodb-connection.ts",
    "mongodb:verify-readonly": "tsx scripts/m3d-atlas-readonly-verify.ts",
    "mongodb:apply-dr04-index": "tsx scripts/apply-dr04-index.ts",
    "auth:verify-live": "tsx scripts/m4-auth-live-verify.ts",
    "orders:verify-live": "tsx scripts/m4-buyer-orders-live-verify.ts",
    "enquiry-appointment:verify-live": "tsx scripts/m5-a-live-verify.ts",
    "db:codegen": "kysely-codegen --dialect mysql --out-file src/lib/db/schema.generated.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "kysely": "0.28.7",
    "mongodb": "^6.21.0",
    "mysql2": "3.15.3",
    "next": "15.5.22",
    "razorpay": "^2.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@playwright/test": "1.62.1",
    "@types/node": "22.18.12",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv": "17.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "kysely-codegen": "0.19.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
