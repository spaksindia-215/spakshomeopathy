# =============================================================================
# Spaks Homeopathy — Next.js environment template
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored
# and MUST NEVER be committed.
#
# Mapping from the Laravel `.env` is documented in blueprint.md §21.
# Owner Decision D-02 (approved) requires that ALL credentials be ROTATED
# during migration. Do not reuse any live Laravel credential value here
# except APP_KEY (see below).
# =============================================================================

# -----------------------------------------------------------------------------
# MONGODB (Owner Decision D-11 — the ACTIVE target database layer)
#
# D-11 (docs/D-11-DATABASE-ARCHITECTURE.md, 2026-08-16) makes MongoDB Atlas
# the production target, superseding the MariaDB/MySQL block below.
#
# DATABASE SAFETY (owner instruction, M3-A authorization, 2026-08-16):
#   - NEVER put real credentials in this file or any committed file.
#   - MONGODB_ENV has NO default — it must be set explicitly to
#     "development", "test", or "production". This is deliberate: an
#     unset/guessed value must never be treated as safe.
#   - MONGODB_ALLOW_PRODUCTION is a SECOND, INDEPENDENT confirmation flag.
#     Connecting with MONGODB_ENV=production requires BOTH this flag AND
#     the owner's separate, explicit authorization for that operation
#     (src/lib/mongodb/client.ts enforces this — see
#     ProductionConnectionBlockedError). Do not set this to "true" to
#     work around the guard without that authorization.
#   - Development MongoDB MUST be a separate cluster/database from
#     production — never point MONGODB_URI at production while
#     MONGODB_ENV=development.
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=spaks_dev
MONGODB_ENV=development
MONGODB_ALLOW_PRODUCTION=false

# -----------------------------------------------------------------------------
# DATABASE — SUPERSEDED BY D-11, RETAINED FOR HISTORICAL/AUDIT CONTINUITY ONLY
# (Laravel: DB_CONNECTION / DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME /
#  DB_PASSWORD)
#
# This block configured the Kysely/MySQL layer built before D-11 changed the
# target architecture to MongoDB Atlas (2026-08-16). It is NOT used by any
# current code path. Not deleted per contract NN-10/G-2 (no deletion without
# approval) — src/lib/db/ was never wired into any application code, so
# retaining this is inert, not a live configuration surface.
#
# Production was MariaDB 10.6.23 (see Milestone 0 Gate Report, D-09).
# Contract T-5: NEVER point development at the production database.
# -----------------------------------------------------------------------------
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=db_newhomo
DATABASE_USER=
DATABASE_PASSWORD=

# Connection pool size. No Laravel equivalent (PHP opens one connection per
# request). Chosen for a Node long-running process; has no observable effect
# on behavior.
DATABASE_POOL_SIZE=10

# -----------------------------------------------------------------------------
# SESSION / CRYPTO
#
# APP_KEY — Laravel: APP_KEY
# CONTRACT NN-9 / F-4: this value MUST be copied VERBATIM from the Laravel
# .env, including the "base64:" prefix. It decrypts password-reset tokens and
# order-cancellation ids that already exist in users' inboxes and browser
# history. Generating a new key BREAKS THOSE LIVE LINKS.
# This is the ONE credential that must NOT be rotated.
APP_KEY=

# Session cookie signing secret for the Next.js session layer.
# No Laravel equivalent (Laravel derives cookie signing from APP_KEY).
# Generate a NEW random 32+ byte value.
SESSION_SECRET=

# Laravel: SESSION_LIFETIME (minutes). Contract F-22 forbids changing this.
SESSION_LIFETIME_MINUTES=120

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# Laravel: APP_URL. Used to build password-reset links.
APP_URL=http://localhost:3000

# Laravel: APP_ENV. NOTE: production Laravel .env has APP_ENV=local and
# APP_DEBUG=true — production debug exposure, covered by the approved D-02
# exception and remediated separately. Do NOT replicate APP_DEBUG=true.
NODE_ENV=development

# -----------------------------------------------------------------------------
# MAIL  (Laravel: MAIL_DRIVER / MAIL_HOST / MAIL_PORT / MAIL_USERNAME /
#        MAIL_PASSWORD / MAIL_ENCRYPTION / MAIL_SENDER)
#
# Production Laravel uses smtp.gmail.com:465 with ssl.
# D-02 (approved): rotate these credentials.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Laravel: MAIL_SENDER — the From address on password-reset emails.
MAIL_SENDER=

# Enquiry notification recipient.
# Laravel HARDCODES this to gauravsvm07@gmail.com in HomeController@saveEnq.
# Blueprint R-3 / Owner Decision D-03 (PENDING, NON-BLOCKING).
# DEFAULT until D-03 is resolved: preserve the current hardcoded recipient
# EXACTLY (contract §13.2). Do not substitute a different address without
# an approved D-03.
ENQUIRY_RECIPIENT=gauravsvm07@gmail.com

# Laravel hardcodes the enquiry email's From address as zeintext@gmail.com.
ENQUIRY_FROM=zeintext@gmail.com

# -----------------------------------------------------------------------------
# UPLOADS  (blueprint §9.6, §14.2)
#
# Laravel writes to public/uploaded_files/<subdir> and serves them directly.
# Paths must remain identical: filenames are stored as bare strings in the DB
# with no path column, and product-detail JS parses a fixed URL segment index
# (blueprint R-13 / P-13).
# -----------------------------------------------------------------------------
UPLOAD_DIR=public/uploaded_files

# -----------------------------------------------------------------------------
# HERBS STORE — RAZORPAY PAYMENTS (CR-003 follow-on, owner-directed
# implementation — see docs/CR-003-HERBAL-ECOMMERCE-SECTION.md §10)
#
# Entirely NEW surface area, unrelated to the legacy Laravel migration —
# there is no Laravel payment integration this traces to (the legacy site's
# `public/cc/` CCAvenue kit was explicitly excluded from porting, §3.1).
#
# Get these from https://dashboard.razorpay.com/app/keys (test mode keys are
# safe to use here — they start with `rzp_test_`). Live/production keys
# (`rzp_live_`) should only ever be used with real production traffic.
#
# When unset, /herbs/checkout automatically falls back to the original
# demo-only order flow (no card fields, nothing transmitted to a payment
# processor) — see src/components/herbs/HerbsCheckoutPage.tsx and
# src/lib/herbs/payments/config.ts's isRazorpayConfigured().
#
# NEVER paste real key values into a chat/AI session, a commit, or any
# file other than .env.local. RAZORPAY_KEY_SECRET in particular must stay
# server-side only — it is never sent to the browser.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — only needed if a webhook endpoint is registered in the
# Razorpay dashboard (Settings → Webhooks) for server-to-server payment
# event notifications, independent of the client-side Checkout confirmation
# flow. See src/lib/herbs/payments/razorpay.ts's
# verifyRazorpayWebhookSignature().
RAZORPAY_WEBHOOK_SECRET=
